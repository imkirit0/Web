# Form submissions are emailed via Resend (https://resend.com). Required in production.
RESEND_API_KEY=
# Who receives submissions (comma-separated). Defaults to info@gteceducation.com.
FORMS_TO=info@gteceducation.com
# Sender; must be on a domain verified in Resend, e.g. "G-TEC Website <website@gteceducation.com>".
FORMS_FROM=
# Old payment/results system once moved to its subdomain. Defaults to https://www.gteceducation.com.
NEXT_PUBLIC_PORTAL_URL=

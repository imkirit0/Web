# Form submissions are emailed via Resend (https://resend.com). Required in production.
RESEND_API_KEY=
# Who receives submissions (comma-separated). Defaults to info@gteceducation.com.
FORMS_TO=info@gteceducation.com
# Sender; must be on a domain verified in Resend, e.g. "G-TEC Website <website@gteceducation.com>".
FORMS_FROM=
# Old payment/results system once moved to its subdomain. Defaults to https://www.gteceducation.com.
NEXT_PUBLIC_PORTAL_URL=
# ICICI Bank Orange Payment Gateway (merchant onboarding kit / developer portal https://api-portal.icici.bank.in).
# Merchant ID and secure key ICICI issues; aggregator ID only if ICICI gave you one.
ICICI_PG_MERCHANT_ID=
ICICI_PG_AGGREGATOR_ID=
ICICI_PG_SECRET=
# initiateSale endpoint. Leave blank for production (https://pgpay.icicibank.com/pg/api/v2/initiateSale);
# set to the UAT URL from ICICI's UAT kit while testing. ICICI posts results to /api/icici/return.
# USD on /onlineinternationalpayment needs USD (currency 840) enabled on the ICICI merchant account.
ICICI_PG_URL=
